# ---- Core -------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://klippers:klippers@localhost:5432/klippers
DATABASE_SSL=false                 # true for most managed Postgres (Render, Neon, RDS…)
CLIENT_URL=http://localhost:5173   # comma-separate multiple origins for CORS (defaults to RENDER_EXTERNAL_URL on Render)
STATIC_DIR=                        # single-service mode: folder containing the built client (set in the root Dockerfile)
SEED_ON_EMPTY=false                # DEMO MODE ONLY: load demo data when empty and re-seed when the demo data version changes (wipes data!)

# ---- Auth (REQUIRED in production: long random strings, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
GOOGLE_CLIENT_ID=                  # optional — enables Google sign-in

# ---- Payments (optional — without a key, card payments run in "mock" mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (optional — logs to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Klippers <no-reply@klippers.app>"

# ---- SMS / WhatsApp via Twilio (optional — logs to console when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- AI style advisor (optional — rule-based fallback when unset)
ANTHROPIC_API_KEY=

# ---- Background jobs (reminders). Set false on all but ONE instance when scaling out.
ENABLE_JOBS=true
